{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
      "icon": {
        "type": "object",
        "required": ["name", "color"],
        "properties": {
          "name": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    },
    "type": "object",
    "required": ["engagement", "contact", "summary", "impact", "expertise", "experience", "education", "languages", "projects"],
    "properties": {
      "engagement": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["icon", "title", "content"],
              "properties": {
                "icon": { "$ref": "#/$defs/icon" },
                "title": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          }
        }
      },
      "contact": {
        "type": "object",
        "required": ["icon", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["icon", "title", "content"],
              "properties": {
                "icon": { "$ref": "#/$defs/icon" },
                "title": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          }
        }
      },
      "summary": {
        "type": "object",
        "required": ["icon", "title", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "impact": {
        "type": "object",
        "required": ["icon", "title", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "expertise": {
        "type": "object",
        "required": ["icon", "title", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "content"],
              "properties": {
                "title": { "type": "string" },
                "content": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    {
                      "type": "object",
                      "required": ["title", "content"],
                      "properties": {
                        "title": { "type": "string" },
                        "content": { "type": "array", "items": { "type": "string" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "experience": {
        "type": "object",
        "required": ["icon", "title", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "content"],
              "properties": {
                "title": {
                  "type": "object",
                  "required": ["company", "job_title", "start", "location", "location_type", "contract_type"],
                  "properties": {
                    "company": { "type": "string" },
                    "job_title": { "type": "string" },
                    "start": {
                      "type": "object",
                      "required": ["year"],
                      "properties": {
                        "month": { "type": "integer" },
                        "year": { "type": "integer" }
                      }
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": ["year"],
                          "properties": {
                            "month": { "type": "integer" },
                            "year": { "type": "integer" }
                          }
                        },
                        { "type": "null" }
                      ]
                    },
                    "location": {
                      "type": "object",
                      "required": ["city", "state", "country"],
                      "properties": {
                        "city": { "type": "string" },
                        "state": { "type": "string" },
                        "country": { "type": "string" }
                      }
                    },
                    "location_type": { "type": "string" },
                    "contract_type": { "type": "string" }
                  }
                },
                "content": {
                  "type": "object",
                  "required": ["activities", "stack"],
                  "properties": {
                    "context": { "type": ["string", "null"] },
                    "role": { "type": ["string", "null"] },
                    "activities": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "stack": {
                      "type": "object",
                      "required": ["languages_and_libs"],
                      "properties": {
                        "languages_and_libs": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "others": {
                          "anyOf": [
                            { "type": "array", "items": { "type": "string" } },
                            { "type": "null" }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "education": {
        "type": "object",
        "required": ["icon", "title", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["icon", "title", "description", "start", "end"],
              "properties": {
                "icon": { "$ref": "#/$defs/icon" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "start": {
                  "type": "object",
                  "required": ["year"],
                  "properties": {
                    "month": { "type": ["integer", "null"] },
                    "year": { "type": "integer" }
                  }
                },
                "end": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["year"],
                      "properties": {
                        "month": { "type": ["integer", "null"] },
                        "year": { "type": "integer" }
                      }
                    },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      },
      "languages": {
        "type": "object",
        "required": ["icon", "title", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["icon", "title", "content"],
              "properties": {
                "icon": { "$ref": "#/$defs/icon" },
                "title": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          }
        }
      },
      "projects": {
        "type": "object",
        "required": ["icon", "title", "content"],
        "properties": {
          "color": { "type": "string" },
          "title": { "type": "string" },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["icon", "title", "content"],
              "properties": {
                "icon": { "$ref": "#/$defs/icon" },
                "title": { "type": "string" },
                "content": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }